      "name": "01. Autenticación y Registro",
      "item": [
        {
          "name": "1.1 Registro Usuario A (Éxito 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Estado HTTP es 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Rol es forzado a usuario', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.usuario.rol).to.eql('usuario');",
                  "});",
                  "pm.test('No expone contraseña ni hash', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.usuario.password).to.be.undefined;",
                  "    pm.expect(json.usuario.password_hash).to.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Demo A\",\n  \"correo\": \"usuarioA@tienda.com\",\n  \"password\": \"User123*\",\n  \"rol\": \"admin\"\n}"
