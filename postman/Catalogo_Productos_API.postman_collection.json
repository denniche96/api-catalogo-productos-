    {
      "name": "02. Catálogo de Productos (Público)",
      "item": [
        {
          "name": "2.1 Listar Catálogo Completo (Público 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Estado HTTP es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Contiene al menos 5 productos de ejemplo', function () {",
                  "    pm.expect(json.productos).to.be.an('array');",
                  "    pm.expect(json.productos.length).to.be.at.least(5);",
                  "});",
                  "if (json.productos && json.productos.length > 0) {",
                  "    pm.environment.set('sampleProductId', json.productos[0].id.toString());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            }
          }
        },
        {
          "name": "2.2 Filtrar Productos por Categoría (Público 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Estado HTTP es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Todos los productos filtrados corresponden a Tecnologia', function () {",
                  "    pm.expect(json.categoriaFiltro).to.eql('Tecnologia');",
                  "    json.productos.forEach(function(p) {",
                  "        pm.expect(p.categoria.toLowerCase()).to.eql('tecnologia');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos?categoria=Tecnologia",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ],
              "query": [
                {
                  "key": "categoria",
                  "value": "Tecnologia"
                }
              ]
            }
          }
        },
        {
          "name": "2.3 Consultar Producto por ID Existente (Público 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Estado HTTP es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('El producto devuelto tiene datos completos y precio > 0', function () {",
                  "    pm.expect(json.producto.id).to.be.a('number');",
                  "    pm.expect(json.producto.nombre).to.be.a('string');",
                  "    pm.expect(json.producto.precio).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos/{{sampleProductId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "{{sampleProductId}}"
              ]
            }
          }
        },
        {
          "name": "2.4 Consultar Producto Inexistente (Error 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Estado HTTP es 404 Not Found', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test('Mensaje de error indica producto no encontrado', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error).to.eql('Producto no encontrado');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
